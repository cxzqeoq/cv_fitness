DATABASE_URL=postgresql://cvfit:cvfit@db:5432/cvfit
# Existing deployments must set this once to the omra.is organization UUID owning legacy rows.
BOOTSTRAP_ORG_ID=
STORAGE_DIR=/data
OPENROUTER_DSN=

# dev or production. Production requires a non-default SESSION_SECRET and HTTPS cookies.
ENVIRONMENT=dev
SESSION_SECRET=change-me

# Staff authentication through omra.is. Register the callback URI in omra.is.
OMRA_IS_ISSUER=https://omra.is
# Optional server-side endpoint for token/JWKS/userinfo calls when the public issuer is unreachable.
OMRA_IS_INTERNAL_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# omra.crm webhook receiver, outbound delivery and public pilot lead intake.
CRM_BASE_URL=http://host.docker.internal:8002
CRM_WEBHOOK_SECRET=
# Company-scoped X-Api-Key; global CRM keys are rejected by the intake endpoint.
CRM_PILOT_API_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# Reverse proxy addresses trusted for X-Forwarded-* headers.
FORWARDED_ALLOW_IPS=127.0.0.1

# Local-only staff session for UI development. Ignored unless ENVIRONMENT=dev.
DEV_STAFF_BYPASS=false
